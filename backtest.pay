"""اختبار تاريخي للإشارات. شغّله: python backtest.py  (بيشتغل مرة ويخلص)"""
import sys
import pandas as pd
from strategy import fetch_history, build_signals


def evaluate(df, s, a, b, horizons=(4, 12, 24), fee=0.001):
    entry = df.o.shift(-1)  # دخول على فتح الشمعة التالية
    out = []
    for name in s.columns:
        d = 1 if name.endswith("long") else -1
        for h in horizons:
            ret = d * (df.c.shift(-h) / entry - 1) - fee
            base = ret.iloc[a:b].mean()
            idx = s.index[s[name] & (s.index >= a) & (s.index < b)]
            r = ret[idx].dropna()
            if len(r) == 0:
                continue
            out.append({
                "signal": name, "h": h, "n": len(r),
                "win%": round((r > 0).mean() * 100, 1),
                "avg%": round(r.mean() * 100, 3),
                "base%": round(base * 100, 3),
                "edge%": round((r.mean() - base) * 100, 3),
            })
    if not out:
        return pd.DataFrame()
    return pd.DataFrame(out).sort_values("edge%", ascending=False)


if __name__ == "__main__":
    symbol = sys.argv[1] if len(sys.argv) > 1 else "BTCUSDT"  # جرّب PAXGUSDT
    df = fetch_history(symbol, "15m", 180)
    s = build_signals(df)
    cut = int(len(df) * 0.7)
    for label, (a, b) in {"تدريب": (0, cut), "اختبار": (cut, len(df))}.items():
        print(f"\n=== {symbol} | {label} ===")
        print(evaluate(df, s, a, b).to_string(index=False))
